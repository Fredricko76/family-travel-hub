{
  "expo": {
    "name": "Family Travel Hub",
    "slug": "family-travel-hub",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "familytravelhub",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.spectrumcoach.familytravelhub",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose booking screenshots and holiday photos to add to a trip."
      }
    },
    "android": {
      "package": "au.com.spectrumcoach.familytravelhub",
      "adaptiveIcon": {
        "backgroundColor": "#DDF0EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
